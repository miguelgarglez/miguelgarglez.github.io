{
  "name": "miguelgarglez.github.io",
  "install": "npm ci && npm ci --prefix cv-chat",
  "start": "true",
  "terminals": [
    {
      "name": "home-dev",
      "command": "npm run dev -- --host 0.0.0.0 --port 4321",
      "description": "Root Astro home on :4321"
    },
    {
      "name": "cvchat-dev",
      "command": "npm run dev --prefix cv-chat -- --host 0.0.0.0 --port 4322",
      "description": "cv-chat Astro app on :4322"
    }
  ],
  "ports": [
    { "name": "home-dev", "port": 4321 },
    { "name": "cvchat-dev", "port": 4322 }
  ]
}
