---
import type { PersonReference } from "../data/people";

type Props = {
  person: PersonReference;
  variant?: "compact" | "detail";
};

const { person, variant = "compact" } = Astro.props;
const monogram =
  person.monogram ??
  person.name
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((part) => part[0]?.toUpperCase() ?? "")
    .join("");
---

<li class:list={["person-card", variant === "detail" && "person-card--detail"]}>
  <a
    class="person-card-media"
    href={person.href}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={`${person.name} (opens in a new tab)`}
  >
    {
      person.image ? (
        <img
          class="person-portrait"
          src={person.image}
          alt=""
          width="160"
          height="160"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <span class="person-monogram" aria-hidden="true">
          {monogram}
        </span>
      )
    }
  </a>

  <div class="person-card-body">
    <p class="reference-type">{person.type}</p>
    <h2 class="reference-title">
      <a href={person.href} target="_blank" rel="noopener noreferrer">{person.name}</a>
    </h2>
    <p class="reference-note">{variant === "detail" ? person.summary : person.note}</p>
    {
      variant === "detail" && (
        <ul class="detail-list person-learns">
          {person.learns.map((lesson) => <li>{lesson}</li>)}
        </ul>
      )
    }
  </div>
</li>
