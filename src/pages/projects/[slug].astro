---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import DirectoryNav from "../../components/DirectoryNav.astro";
import MobileDirectoryMenu from "../../components/MobileDirectoryMenu.astro";
import ThemeToggle from "../../components/ThemeToggle.astro";
import ProjectImageGallery from "../../components/ProjectImageGallery.astro";
import { projects } from "../../data/projects";
import type { Project } from "../../data/projects";
import { getPostsForProject } from "../../lib/post-relations";
import { pageTitle } from "../../../shared/seo/config";
import { breadcrumbSchema, creativeWorkSchema } from "../../lib/seo-schemas";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => !data.draft);

  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project, allPosts: posts },
  }));
}

type Props = {
  project: Project;
  allPosts: CollectionEntry<"posts">[];
};

const { project, allPosts } = Astro.props;
const buildNotes = getPostsForProject(project.slug, allPosts);
const sectionId = (title: string) =>
  `project-${title
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "")}-title`;
const seenHrefs = new Set<string>();
const detailLinks = [
  project.showcaseUrl && { label: "Product showcase", href: project.showcaseUrl },
  project.liveUrl && { label: "Live preview", href: project.liveUrl },
  project.repositoryUrl && { label: "Repository", href: project.repositoryUrl },
].filter((link): link is { label: string; href: string } => {
  if (!link) return false;
  if (seenHrefs.has(link.href)) return false;
  seenHrefs.add(link.href);
  return true;
});
const ogImage = `/og/projects/${project.slug}.png`;
---

<BaseLayout
  title={pageTitle(project.displayName)}
  description={project.summary}
  canonicalPath={`/projects/${project.slug}/`}
  image={ogImage}
  imageAlt={`${project.displayName} — Miguel García`}
  jsonLd={[
    creativeWorkSchema({
      name: project.displayName,
      description: project.summary,
      slug: project.slug,
      year: String(project.year),
      url: project.liveUrl,
    }),
    breadcrumbSchema([
      { name: "Home", path: "/" },
      { name: "Projects", path: "/projects/" },
      { name: project.displayName, path: `/projects/${project.slug}/` },
    ]),
  ]}
>
  <main class="layout">
    <div class="page-shell">
      <DirectoryNav active="projects" />

      <article class="content-column project-detail">
        <header class="masthead">
          <a class="eyebrow masthead-home" href="/">Miguel Garcia • Project</a>
          <div class="masthead-actions">
            <ThemeToggle />
            <MobileDirectoryMenu active="projects" />
          </div>
        </header>

        <section class="detail-hero">
          <p class="detail-back">
            <a class="text-link" href="/projects/">← All projects</a>
          </p>
          <h1>{project.displayName}</h1>
          <p class="lead">{project.summary}</p>
        </section>

        {project.images && project.images.length > 0 && (
          <ProjectImageGallery images={project.images} label="Product" />
        )}

        {
          project.sections?.map((section) => {
            const headingId = sectionId(section.title);
            return (
              <section class="detail-section" aria-labelledby={headingId}>
                <p class="section-label" id={headingId}>
                  {section.title}
                </p>
                {section.body && <p class="detail-copy">{section.body}</p>}
                {section.items && (
                  <ul class="detail-list">
                    {section.items.map((item) => <li>{item}</li>)}
                  </ul>
                )}
              </section>
            );
          })
        }

        <section class="detail-section" aria-labelledby="project-capabilities-title">
          <p class="section-label" id="project-capabilities-title">Capabilities</p>
          <ul class="detail-list">
            {project.capabilities.map((capability) => <li>{capability}</li>)}
          </ul>
        </section>

        <section class="detail-section" aria-labelledby="project-stack-title">
          <p class="section-label" id="project-stack-title">Stack</p>
          <ul class="stack" aria-label="Tech stack">
            {project.stack.map((item) => <li>{item}</li>)}
          </ul>
        </section>

        {
          detailLinks.length > 0 && (
            <section class="detail-section" aria-labelledby="project-links-title">
              <p class="section-label" id="project-links-title">Links</p>
              <div class="project-links">
                {detailLinks.map((link) => (
                  <a href={link.href} target="_blank" rel="noopener noreferrer">
                    {link.label}
                  </a>
                ))}
              </div>
            </section>
          )
        }

        {
          buildNotes.length > 0 && (
            <section class="detail-section" aria-labelledby="project-build-notes-title">
              <p class="section-label" id="project-build-notes-title">Build notes</p>
              <ul class="post-end-links project-build-notes">
                {
                  buildNotes.map((note) => (
                    <li>
                      {
                        note.data.seriesOrder !== undefined && (
                          <span class="post-end-link-label">
                            Part {note.data.seriesOrder}
                          </span>
                        )
                      }
                      <a href={`/posts/${note.id}`}>{note.data.title}</a>
                      <span class="post-end-link-meta">{note.data.description}</span>
                    </li>
                  ))
                }
              </ul>
            </section>
          )
        }
      </article>
    </div>
  </main>
</BaseLayout>
